# FreightIQ Environment Configuration
# Copy this file to .env and adjust variables as needed

# Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Google Cloud Platform (Optional for local mode, required for cloud sync)
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCS_BUCKET_NAME=freightiq-raw-and-curated
BIGQUERY_DATASET=freightiq_analytics
GOOGLE_APPLICATION_CREDENTIALS=path/to/service_account.json

# Server Settings
API_HOST=0.0.0.0
API_PORT=8000
UI_PORT=7860
ENVIRONMENT=development
